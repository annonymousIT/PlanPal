# Copy to .env and fill in real values. NEVER commit the real .env.
# Local-dev defaults below; replace for production.

# --- Database (PostgreSQL) ---
# Railway: get from your Postgres plugin → Connect → Postgres Connection URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Google OAuth 2.0 ---
# Get from: https://console.cloud.google.com/apis/credentials
# Scopes required: calendar, userinfo.email, userinfo.profile
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# IMPORTANT: this exact URL must be in "Authorized redirect URIs" of the
# OAuth client. For prod, change to https://api.your-domain.com/auth/google/callback
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# --- Gemini API ---
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-key

# --- Crypto secrets ---
# JWT_SECRET: any string ≥32 chars. Used for HS256 signing of access/refresh JWTs.
JWT_SECRET=change-me-to-something-long-and-random-at-least-32-chars

# AES_KEY: MUST be EXACTLY 32 bytes (AES-256). Used to encrypt OAuth tokens
# at rest. See backend/security.go and issue #6.
AES_KEY=ChangeMe32BytesExactlyForAES256_

# --- Frontend URL ---
# Used for CORS allowlist and the OAuth callback redirect target.
# For prod: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# --- Optional ---
# Railway injects PORT automatically; this fallback is for local dev only.
PORT=8080
